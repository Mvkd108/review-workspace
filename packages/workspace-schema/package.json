{
  "name": "@review-workspace/schema",
  "version": "0.1.0",
  "description": "Public schema for coding-agent review workspaces",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "files": ["dist", "src", "schema", "openapi.json"],
  "exports": {
    ".": { "types": "./src/index.ts", "import": "./dist/index.js" },
    "./workspace.schema.json": "./schema/workspace.schema.json",
    "./openapi.json": "./openapi.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs"
  }
}
