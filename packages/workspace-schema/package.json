{
  "name": "@review-workspace/schema",
  "version": "0.2.0",
  "description": "Public schema for coding-agent review workspaces",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/Mvkd108/review-workspace.git", "directory": "packages/workspace-schema" },
  "bugs": { "url": "https://github.com/Mvkd108/review-workspace/issues" },
  "homepage": "https://github.com/Mvkd108/review-workspace#readme",
  "keywords": ["code-review", "coding-agent", "git", "worktree", "json-schema", "openapi"],
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "files": ["dist", "src", "schema", "openapi.json"],
  "exports": {
    ".": { "types": "./src/index.ts", "import": "./dist/index.js" },
    "./workspace.schema.json": "./schema/workspace.schema.json",
    "./openapi.json": "./openapi.json"
  },
  "//publishConfig": "Workspace consumers typecheck against src so the dev loop needs no build step; published consumers get generated declarations instead.",
  "publishConfig": {
    "access": "public",
    "types": "dist/index.d.ts",
    "exports": {
      ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
      "./workspace.schema.json": "./schema/workspace.schema.json",
      "./openapi.json": "./openapi.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs"
  }
}
